# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/observatory.db

# LLM Advisory Provider Configuration (Optional, keys server-side only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# OIDC / Keycloak Authentication Configuration
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/support-observatory
OIDC_CLIENT_ID=support-observatory-client
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
OIDC_AUDIENCE=support-observatory-client
